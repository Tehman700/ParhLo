# Copy to .env (repo root). The backend reads it on startup. Never commit real values.

# --- Database: Postgres with the pgvector extension (we use Neon) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- AI ---
# OpenAI key (sk-...): summaries (gpt-5-nano), editor + Ask + extraction (gpt-5-mini), embeddings (text-embedding-3-small)
LLM_API_KEY=
LLM_MODEL=openai/gpt-5-mini
LLM_FAST_MODEL=openai/gpt-5-nano
EMBEDDING_MODEL=openai/text-embedding-3-small
# Jev (TypeSafe System One): topic / junk / importance per story, summary checks, Ask routing. Optional: falls back to the LLM.
TYPESAFE_API_KEY=

# --- Sign-in and sessions ---
SESSION_SECRET=                      # long random string; signs sessions, unsubscribe links and n8n events
PUBLIC_URL=http://localhost:3000     # where the browser sees the app (OAuth redirects, email links)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_DEMO_USERS=true

# --- Email: Gmail SMTP (app password) first, AWS SES as fallback ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
PARHLO_AWS_ACCESS_KEY_ID=
PARHLO_AWS_SECRET_ACCESS_KEY=
PARHLO_AWS_REGION=ap-south-1
EMAIL_FROM=

# --- Jobs ---
CRON_SECRET=                         # Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
N8N_WEBHOOK_URL=                     # n8n workflow from n8n/paper-refresh.workflow.json (optional)

# --- Pre-event starter modules (chat/agent/RAG/ML/vision); off for ParhLo ---
ENABLE_STARTER=false

# SWS instant web search (following a new name, "Search the web" in Ask). Free: 1,000 credits a month.
TAVILY_API_KEY=
