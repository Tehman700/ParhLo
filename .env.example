# Copy to .env (repo root). The backend reads it on startup.

# --- LLM: any OpenAI-compatible API. Pick ONE block. ---

# Vercel AI Gateway (router: one key, many providers)
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# LLM_VISION_MODEL=

# OpenAI direct
# LLM_BASE_URL=
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# OpenRouter (router)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini

# Ollama (local; any non-empty key works)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

LLM_TEMPERATURE=0.2

# --- Embeddings for RAG: local (offline keyword-ish) | api (semantic, uses provider) ---
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=text-embedding-3-small

# --- Jev (TypeSafe AI System One model) — fast typed decisions/routing. Optional. ---
# TYPESAFE_API_KEY=

# --- Optional modules ---
ENABLE_RAG=true
ENABLE_ML=true
ENABLE_VISION=true
AGENT_MAX_ITERATIONS=6
