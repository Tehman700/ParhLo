{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/email",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/sws/00",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/sws/01",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/sws/02",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sws/03",
      "schedule": "0 3 * * *"
    },
    {
